generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  email        String        @unique
  name         String?
  password     String?
  profile      Profile?
  role         String?       @default("STUDENT") // "STUDENT" | "RECRUITER"
  savedJobs    SavedJob[]
  applications Application[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model PostedJob {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  recruiterEmail String
  recruiterName  String?
  title          String
  company        String
  location       String
  salary         String?
  category       String   @default("General")
  description    String
  skills         String   // Comma-separated skills
  applyUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Profile {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  degree      String   // e.g. "Computer Science", "BBA", "Design", etc.
  skills      String   // Stored as serialized JSON string or comma-separated values
  targetRoles String   // Stored as serialized JSON string or comma-separated values
  resumeUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SavedJob {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  title     String
  company   String
  location  String?
  salary    String?
  source    String   // e.g., "LinkedIn", "JSearch", "Jooble", "Adzuna"
  applyUrl  String?
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
}

model DegreeKeywordMapping {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  degree    String   @unique // e.g., "Computer Science", "BBA", "Design"
  keywords  String   // Comma-separated query keywords for job board search
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId       String
  title       String
  company     String
  location    String?
  source      String   // e.g., "LinkedIn", "Indeed"
  applyUrl    String?
  status      String   // "Applied", "Reviewing", "Interviewing", "Offer", "Rejected"
  coverLetter String?  // AI-generated cover letter
  appliedAt   DateTime @default(now())

  @@unique([userId, jobId])
}
